---
interface Props {
  weddingDate?: string;
}

const { weddingDate = "2026-12-29T16:00:00+05:30" } = Astro.props;

// Calculate exact initial digits on load so there are zero placeholder dashes
const targetEpoch = Date.parse(weddingDate);
const initialDiff = Math.max(0, targetEpoch - Date.now());
const initialDays = Math.floor(initialDiff / 86400000);
const initialHours = Math.floor((initialDiff % 86400000) / 3600000);
const initialMinutes = Math.floor((initialDiff % 3600000) / 60000);
const initialSeconds = Math.floor((initialDiff % 60000) / 1000);
---

<!-- Live Countdown Section (Clean, Seamless Circular Rings) -->
<section 
  id="countdown-section" 
  class="invite-section countdown-dormant reveal-on-scroll" 
  data-target-date={weddingDate}
  aria-label="Wedding Countdown"
  aria-hidden="true"
>
  <!-- Dedicated Clean Lavender 4-Corner Artwork Layer with Symmetrical Canopy Composition -->
  <div class="lavender-section-decor decor-comp-countdown" aria-hidden="true">
    <div class="lavender-corner-item lavender-corner-tl"></div>
    <div class="lavender-corner-item lavender-corner-tr"></div>
    <div class="lavender-corner-item lavender-corner-bl"></div>
    <div class="lavender-corner-item lavender-corner-br"></div>
    <div class="countdown-ambient-glow"></div>
  </div>

  <!-- Perimeter Luxury Double Border Inset -->
  <div class="invitation-page-border" aria-hidden="true">
    <div class="invitation-page-inner-border"></div>
  </div>
  <div class="invitation-corner-ornaments" aria-hidden="true">
    <span class="corner-ornament corner-top-left">❦</span>
    <span class="corner-ornament corner-top-right">❦</span>
    <span class="corner-ornament corner-bottom-left">❦</span>
    <span class="corner-ornament corner-bottom-right">❦</span>
  </div>

  <div class="countdown-container">
    <!-- State 1: Active Circular Countdown Rings -->
    <div class="countdown-state-panel countdown-state-timer" id="countdown-state-timer">
      <!-- Enhanced Header: Entwined Wedding Rings + Christian Wedding Theme & Scripture -->
      <div class="countdown-header-block">
        <div class="countdown-rings-graphic-wrap" aria-hidden="true">
          <svg class="wedding-rings-svg" viewBox="0 0 120 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="ringGoldGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#F5E7C4" />
                <stop offset="35%" stop-color="#C5A56D" />
                <stop offset="70%" stop-color="#9C7938" />
                <stop offset="100%" stop-color="#D8BC82" />
              </linearGradient>
              <linearGradient id="ringGoldGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#F9ECD0" />
                <stop offset="35%" stop-color="#D4B67D" />
                <stop offset="70%" stop-color="#A47F3E" />
                <stop offset="100%" stop-color="#C5A56D" />
              </linearGradient>
              <linearGradient id="gemFacetGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFFFFF" />
                <stop offset="60%" stop-color="#EADBFA" />
                <stop offset="100%" stop-color="#C5A56D" />
              </linearGradient>
              <filter id="softRingGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#C5A56D" flood-opacity="0.35" />
              </filter>
            </defs>
            <g class="wedding-rings-group" filter="url(#softRingGlow)">
              <!-- Back ring (Right ring) -->
              <ellipse cx="71" cy="34" rx="20" ry="14" transform="rotate(14 71 34)" stroke="url(#ringGoldGrad2)" stroke-width="4.2" fill="none" />
              <ellipse cx="71" cy="34" rx="19.2" ry="13.2" transform="rotate(14 71 34)" stroke="rgba(255, 255, 255, 0.45)" stroke-width="0.8" fill="none" />

              <!-- Front ring (Left ring) -->
              <ellipse cx="49" cy="34" rx="20" ry="14" transform="rotate(-14 49 34)" stroke="url(#ringGoldGrad1)" stroke-width="4.2" fill="none" />
              <ellipse cx="49" cy="34" rx="19.2" ry="13.2" transform="rotate(-14 49 34)" stroke="rgba(255, 255, 255, 0.55)" stroke-width="0.8" fill="none" />

              <!-- Overlap arc: realistic 3D interlocking illusion -->
              <path d="M 57 23.5 A 20 14 0 0 1 73 21" stroke="url(#ringGoldGrad2)" stroke-width="4.2" stroke-linecap="round" fill="none" />

              <!-- Solitaire diamond accent on left ring -->
              <g class="ring-solitaire-gem" transform="translate(36, 20)">
                <polygon points="0,-4 3.5,0 0,4.5 -3.5,0" fill="url(#gemFacetGrad)" />
                <circle cx="0" cy="0" r="1.2" fill="#FFFFFF" />
              </g>

              <!-- Subtle romantic sparkle star on right ring -->
              <path class="ring-sparkle-star" d="M84 18 Q84 21 87 21 Q84 21 84 24 Q84 21 81 21 Q84 21 84 18Z" fill="#F7EDD2" />
            </g>
          </svg>
        </div>

        <h2 class="countdown-heading font-serif">Two Hearts. One Covenant.</h2>
        
        <p class="countdown-scripture font-serif-sub">
          <span class="scripture-verse">“He has made everything beautiful in its time.”</span>
          <span class="scripture-cite">Ecclesiastes 3:11</span>
        </p>

        <div class="countdown-message-divider" aria-hidden="true">
          <span class="divider-line"></span>
          <span class="divider-flourish">❦</span>
          <span class="divider-line"></span>
        </div>
      </div>

      <div class="countdown-rings-grid" id="countdown-rings-container">
        <!-- DAYS (Deep Lavender) -->
        <div class="countdown-circle-unit unit-days">
          <div class="circle-graphic-box">
            <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="ring-bg" cx="50" cy="50" r="42" />
              <circle class="ring-meter" id="ring-days-meter" cx="50" cy="50" r="42" />
            </svg>
            <div class="circle-center-content">
              <span id="countdown-days" class="countdown-circle-num font-serif">{String(initialDays).padStart(2, "0")}</span>
            </div>
          </div>
          <span class="countdown-circle-label font-sans">DAYS</span>
        </div>

        <!-- HOURS (Mauve) -->
        <div class="countdown-circle-unit unit-hours">
          <div class="circle-graphic-box">
            <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="ring-bg" cx="50" cy="50" r="42" />
              <circle class="ring-meter" id="ring-hours-meter" cx="50" cy="50" r="42" />
            </svg>
            <div class="circle-center-content">
              <span id="countdown-hours" class="countdown-circle-num font-serif">{String(initialHours).padStart(2, "0")}</span>
            </div>
          </div>
          <span class="countdown-circle-label font-sans">HOURS</span>
        </div>

        <!-- MINUTES (Dusty Lilac) -->
        <div class="countdown-circle-unit unit-mins">
          <div class="circle-graphic-box">
            <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="ring-bg" cx="50" cy="50" r="42" />
              <circle class="ring-meter" id="ring-mins-meter" cx="50" cy="50" r="42" />
            </svg>
            <div class="circle-center-content">
              <span id="countdown-mins" class="countdown-circle-num font-serif">{String(initialMinutes).padStart(2, "0")}</span>
            </div>
          </div>
          <span class="countdown-circle-label font-sans">MINUTES</span>
        </div>

        <!-- SECONDS (Champagne Gold) -->
        <div class="countdown-circle-unit unit-secs">
          <div class="circle-graphic-box">
            <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="ring-bg" cx="50" cy="50" r="42" />
              <circle class="ring-meter" id="ring-secs-meter" cx="50" cy="50" r="42" />
            </svg>
            <div class="circle-center-content">
              <span id="countdown-secs" class="countdown-circle-num font-serif">{String(initialSeconds).padStart(2, "0")}</span>
            </div>
          </div>
          <span class="countdown-circle-label font-sans">SECONDS</span>
        </div>
      </div>
    </div>

    <!-- State 2: It's Our Special Day! (29 Dec 4:00 PM IST to Midnight IST) -->
    <div class="countdown-state-panel countdown-state-special-day" id="countdown-state-special-day" style="display: none;" aria-live="polite">
      <div class="special-day-card">
        <div class="countdown-state-heart-wrap" aria-hidden="true">
          <svg class="romantic-beating-heart-svg" viewBox="0 0 32 32" fill="none">
            <path d="M16 28C16 28 3 20.5 3 11.5C3 7.5 6 4.5 10 4.5C12.5 4.5 14.7 5.8 16 7.8C17.3 5.8 19.5 4.5 22 4.5C26 4.5 29 7.5 29 11.5C29 20.5 16 28 16 28Z" fill="url(#specialHeartGrad)" />
            <defs>
              <linearGradient id="specialHeartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#C5A56D" />
                <stop offset="50%" stop-color="#9B7CB8" />
                <stop offset="100%" stop-color="#73558D" />
              </linearGradient>
            </defs>
          </svg>
        </div>
        <h2 class="special-day-title font-serif">It's Our Special Day!</h2>
        <div class="countdown-message-divider" aria-hidden="true">
          <span class="divider-line"></span>
          <span class="divider-flourish">❦</span>
          <span class="divider-line"></span>
        </div>
        <p class="special-day-subtitle font-serif-sub">Two hearts. One covenant. A lifetime of love.</p>
      </div>
    </div>

    <!-- State 3: Oops! You're Too Late! We're Married! (30 Dec 12:00 AM IST onwards) -->
    <div class="countdown-state-panel countdown-state-married" id="countdown-state-married" style="display: none;" aria-live="polite">
      <div class="married-card">
        <div class="countdown-state-heart-wrap" aria-hidden="true">
          <svg class="romantic-beating-heart-svg" viewBox="0 0 32 32" fill="none">
            <path d="M16 28C16 28 3 20.5 3 11.5C3 7.5 6 4.5 10 4.5C12.5 4.5 14.7 5.8 16 7.8C17.3 5.8 19.5 4.5 22 4.5C26 4.5 29 7.5 29 11.5C29 20.5 16 28 16 28Z" fill="url(#marriedHeartGrad)" />
            <defs>
              <linearGradient id="marriedHeartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#C5A56D" />
                <stop offset="50%" stop-color="#835BA3" />
                <stop offset="100%" stop-color="#552F7A" />
              </linearGradient>
            </defs>
          </svg>
        </div>
        <p class="married-badge font-serif">Oops! You're Too Late!</p>
        <h2 class="married-title font-serif">We're Married!</h2>
        <div class="countdown-message-divider" aria-hidden="true">
          <span class="divider-line"></span>
          <span class="divider-flourish">❦</span>
          <span class="divider-line"></span>
        </div>
        <p class="married-subtitle font-serif-sub">Our forever has officially begun.</p>
      </div>
    </div>
  </div>

  <!-- Dedicated Confetti Canvas for State 2 Celebratory Burst -->
  <canvas id="countdown-confetti-canvas" class="countdown-confetti-canvas" aria-hidden="true"></canvas>
</section>