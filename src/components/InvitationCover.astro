---
interface Props {
  brideName: string;
  groomName: string;
  welcomeMessage: string;
  formattedDate: string;
  destination: string;
}

const { brideName, groomName, welcomeMessage, formattedDate, destination } = Astro.props;
---

<section id="invitation-cover" class="invitation-page-fullbleed">
  <!-- Mobile-Only Exact Supplied Reference Visual -->
  <div class="mobile-supplied-cover-wrap" aria-hidden="true">
    <img 
      src="/jony-wedding/assets/decorations/supplied-invitation-full.jpg" 
      alt="Jony & Sunny Wedding Invitation" 
      class="mobile-supplied-cover-img" 
      width="768" 
      height="1024"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <!-- Dedicated Lavender Floral Corner Artwork Layer -->
  <div class="lavender-floral-corners" aria-hidden="true">
    <div class="lavender-corner-item lavender-corner-tr"></div>
    <div class="lavender-corner-item lavender-corner-bl"></div>
    <div class="lavender-corner-item lavender-corner-tl"></div>
    <div class="lavender-corner-item lavender-corner-br"></div>
  </div>

  <!-- Floral Background Artwork Layer (Option 1 & 2) -->
  <div class="invitation-floral-art-layer" aria-hidden="true"></div>

  <!-- Perimeter Luxury Double Border Inset -->
  <div class="invitation-page-border" aria-hidden="true">
    <div class="invitation-page-inner-border"></div>
  </div>

  <!-- 4 Corner Luxury Botanical Ornaments -->
  <div class="invitation-corner-ornaments" aria-hidden="true">
    <span class="corner-ornament corner-top-left">❦</span>
    <span class="corner-ornament corner-top-right">❦</span>
    <span class="corner-ornament corner-bottom-left">❦</span>
    <span class="corner-ornament corner-bottom-right">❦</span>
  </div>

  <!-- Invitation Main Body Covering the Full Viewport -->
  <div class="invitation-full-container">
    <!-- Top Header Group: Monogram Crest + Introductory Welcome -->
    <div class="invitation-header-block">
      <div class="invitation-crest-emblem">
        <img 
          src="/jony-wedding/assets/decorations/wedding-logo-crest.png" 
          alt="J&S Royal Wedding Monogram Crest" 
          class="invitation-logo-img"
          width="208"
          height="208"
          decoding="async"
        />
      </div>
      <p class="invitation-lead-text cover-intro-lead">{welcomeMessage}</p>
    </div>

    <!-- Centerpiece: Couple Names Display -->
    <div class="invitation-couple-block cover-couple-names">
      <h1 class="invitation-groom-name cover-groom-name">{groomName}</h1>
      <span class="invitation-ampersand cover-ampersand">&</span>
      <h1 class="invitation-bride-name cover-bride-name">{brideName}</h1>
    </div>

    <!-- Sacred Scripture & Blessing Block -->
    <div class="invitation-blessing-block">
      <div class="botanical-divider hero-divider">
        <span class="botanical-divider-icon">❦</span>
      </div>
      <p class="invitation-sub-lead">
        “For of him, and through him, and to him, are all things: to whom be glory for ever. Amen.”
        <span class="invitation-verse-citation">— Romans 11:36</span>
      </p>
    </div>

    <!-- Refined Interactive Scroll-Down Indicator -->
    <a 
      href="#scratch-reveal-section" 
      id="hero-scroll-btn" 
      class="invitation-scroll-prompt" 
      role="button"
      aria-label="Scroll to explore the wedding invitation"
    >
      <span class="invitation-scroll-sparkle">✦</span>
      <span class="invitation-scroll-label">SCROLL TO EXPLORE</span>
      <span class="invitation-scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script>
  // Smooth scroll handler for the hero scroll-down button
  const scrollBtn = document.getElementById('hero-scroll-btn');
  if (scrollBtn) {
    const onScrollToScratch = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      const target = document.getElementById('scratch-reveal-section');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };
    scrollBtn.addEventListener('click', onScrollToScratch);
  }
</script>