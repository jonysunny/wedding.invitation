---
// RibbonOpeningExperience.astro
// Premium Lavender Floral Ribbon-Opening Interaction with Decorative Stickers
---

<div 
  id="ribbon-opening-overlay" 
  class="ribbon-opening-overlay" 
  role="dialog" 
  aria-modal="true" 
  aria-label="Interactive Lavender Floral Wedding Invitation Ribbon"
>
  <!-- 1. Ambient Background Layer with Watercolor Lavender Hues -->
  <div class="ribbon-ambient-backdrop" aria-hidden="true">
    <div class="ribbon-bg-vignette"></div>
    <div class="ribbon-bg-floral-tl"></div>
    <div class="ribbon-bg-floral-tr"></div>
    <div class="ribbon-bg-floral-bl"></div>
    <div class="ribbon-bg-floral-br"></div>
  </div>

  <!-- Discreet Skip Intro Option in Top-Right Corner -->
  <button 
    type="button" 
    id="ribbon-skip-intro-btn" 
    class="ribbon-skip-intro-btn" 
    aria-label="Skip ribbon opening animation"
  >
    Skip Intro &rarr;
  </button>

  <!-- 2. Main Center Invitation Stage -->
  <div class="ribbon-stage">
    
    <!-- Invitation Card Panel (Underneath the Ribbon) -->
    <div class="ribbon-card-panel">
      <!-- 4 Matching Lavender Floral Corners -->
      <div class="ribbon-bg-floral-tl" aria-hidden="true"></div>
      <div class="ribbon-bg-floral-tr" aria-hidden="true"></div>
      <div class="ribbon-bg-floral-bl" aria-hidden="true"></div>
      <div class="ribbon-bg-floral-br" aria-hidden="true"></div>

      <!-- Decorative Inner Frame -->
      <div class="ribbon-card-frame">
        <div class="ribbon-card-watermark">
          <div class="ribbon-invited-header">
            <span class="ribbon-invited-flourish" aria-hidden="true">❦</span>
            <span class="ribbon-invited-text font-serif">YOU'RE INVITED</span>
            <span class="ribbon-invited-flourish" aria-hidden="true">❦</span>
          </div>
          <span class="ribbon-card-monogram font-script">J &amp; S</span>
          <span class="ribbon-card-subtitle font-serif">A CELEBRATION OF LOVE</span>
        </div>
      </div>
    </div>

    <!-- Scripture & Covenant Inscription (Pre-Open Screen) -->
    <div class="ribbon-scripture-container" aria-label="Wedding Scripture and Covenant">
      <p class="ribbon-scripture-verse font-serif">“I have found the one whom my soul loves.”</p>
      <span class="ribbon-scripture-ref font-serif">Song of Solomon 3:4</span>
      <div class="ribbon-scripture-divider" aria-hidden="true">
        <span class="scripture-line"></span>
        <span class="scripture-sparkle">✦</span>
        <span class="scripture-line"></span>
      </div>
      <p class="ribbon-covenant-text font-serif">TWO LIVES. ONE COVENANT. IN CHRIST.</p>
    </div>

    <!-- 3. Decorative Wedding Stickers Layer (Floating Elegantly) -->
    <div class="ribbon-stickers-layer" aria-hidden="true">
      <!-- Sticker 1: Watercolor Lavender Blossom (Top-Left of Ribbon) -->
      <div class="wedding-sticker sticker-flower-1" title="Lilac Rose">
        <svg viewBox="0 0 80 80" width="64" height="64" fill="none">
          <circle cx="40" cy="40" r="32" fill="#D8C4EC" fill-opacity="0.35" />
          <path d="M40 16 C30 26 22 34 26 48 C30 60 50 60 54 48 C58 34 50 26 40 16 Z" fill="#BEA6D6" />
          <path d="M40 24 C34 32 30 38 33 46 C36 53 44 53 47 46 C50 38 46 32 40 24 Z" fill="#9B7CB8" />
          <circle cx="40" cy="42" r="5" fill="#C5A56D" />
          <path d="M26 48 C16 42 14 30 20 22 C26 26 26 38 26 48 Z" fill="#A7B1A2" fill-opacity="0.8" />
          <path d="M54 48 C64 42 66 30 60 22 C54 26 54 38 54 48 Z" fill="#A7B1A2" fill-opacity="0.8" />
        </svg>
      </div>

      <!-- Sticker 2: Champagne Gold Wax Heart Seal (Top-Right) -->
      <div class="wedding-sticker sticker-heart-seal" title="Gold Heart Seal">
        <div class="seal-heart-inner">
          <span class="seal-icon">♥</span>
        </div>
      </div>

      <!-- Sticker 3: Botanical Lavender Sprig (Bottom-Left) -->
      <div class="wedding-sticker sticker-sprig-1" title="Lavender Sprig">
        <svg viewBox="0 0 60 80" width="52" height="70" fill="none">
          <path d="M30 75 Q32 45 28 10" stroke="#7E8A79" stroke-width="2.5" stroke-linecap="round" />
          <ellipse cx="23" cy="20" rx="5" ry="8" transform="rotate(-30 23 20)" fill="#BEA6D6" />
          <ellipse cx="37" cy="22" rx="5" ry="8" transform="rotate(30 37 22)" fill="#9B7CB8" />
          <ellipse cx="24" cy="35" rx="5" ry="8" transform="rotate(-35 24 35)" fill="#BEA6D6" />
          <ellipse cx="36" cy="37" rx="5" ry="8" transform="rotate(35 36 37)" fill="#73558D" />
          <ellipse cx="25" cy="50" rx="4.5" ry="7" transform="rotate(-30 25 50)" fill="#BEA6D6" />
          <ellipse cx="35" cy="52" rx="4.5" ry="7" transform="rotate(30 35 52)" fill="#9B7CB8" />
        </svg>
      </div>

      <!-- Sticker 4: Delicate Gold Foliage Motif (Bottom-Right) -->
      <div class="wedding-sticker sticker-botanical-gold" title="Gold Botanical Motif">
        <svg viewBox="0 0 70 70" width="56" height="56" fill="none">
          <circle cx="35" cy="35" r="28" stroke="#C5A56D" stroke-width="1.2" stroke-dasharray="3 3" />
          <path d="M35 15 C35 25 25 35 15 35 C25 35 35 45 35 55 C35 45 45 35 55 35 C45 35 35 25 35 15 Z" fill="#C5A56D" fill-opacity="0.25" stroke="#C5A56D" stroke-width="1" />
          <circle cx="35" cy="35" r="4" fill="#C5A56D" />
        </svg>
      </div>
    </div>

    <!-- 4. Satin Lilac Ribbon Wrapping System -->
    <div id="ribbon-interactive-wrap" class="ribbon-interactive-wrap" role="button" tabindex="0" aria-label="Tap or click to open the wedding invitation">
      
      <!-- Horizontal Satin Ribbon Band -->
      <div class="ribbon-band ribbon-band-horizontal">
        <div class="ribbon-shimmer-highlight"></div>
      </div>

      <!-- Vertical Satin Ribbon Band -->
      <div class="ribbon-band ribbon-band-vertical">
        <div class="ribbon-shimmer-highlight"></div>
      </div>

      <!-- Center Ornate Satin Bow Assembly -->
      <div class="ribbon-bow-assembly">
        <!-- Bow Left Loop -->
        <div class="bow-loop bow-loop-left">
          <div class="bow-loop-fold"></div>
          <div class="bow-loop-shadow"></div>
        </div>

        <!-- Bow Right Loop -->
        <div class="bow-loop bow-loop-right">
          <div class="bow-loop-fold"></div>
          <div class="bow-loop-shadow"></div>
        </div>

        <!-- Bow Left Tail (Draping downward) -->
        <div class="bow-tail bow-tail-left">
          <div class="bow-tail-crease"></div>
        </div>

        <!-- Bow Right Tail (Draping downward) -->
        <div class="bow-tail bow-tail-right">
          <div class="bow-tail-crease"></div>
        </div>

        <!-- Central Royal Gold Crest Medallion Knot -->
        <div class="bow-center-seal" id="bow-center-seal">
          <div class="seal-gold-inner-disc">
            <img 
              src="/jony-wedding/assets/decorations/wedding-logo-crest.png" 
              alt="J&amp;S Royal Crest ESTD. 2024" 
              class="seal-crest-img"
              width="80"
              height="80"
            />
          </div>
        </div>
      </div>

      <!-- 5. Tap to Open Interaction Prompt -->
      <div class="ribbon-prompt-container">
        <div class="ribbon-tap-pill">
          <span class="ribbon-sparkle-icon">✦</span>
          <span class="ribbon-prompt-text font-serif">TAP TO OPEN</span>
          <span class="ribbon-sparkle-icon">✦</span>
        </div>
        <p class="ribbon-sub-caption">An invitation to celebrate the sacred wedding of Jony &amp; Sunny</p>
      </div>

    </div><!-- /ribbon-interactive-wrap -->

  </div><!-- /ribbon-stage -->

  <!-- Soft Lavender Light Bloom Overlay for Phase 3/4 Transition -->
  <div class="ribbon-light-bloom" id="ribbon-light-bloom" aria-hidden="true"></div>

</div>

<style>
/* ==========================================================================
   RIBBON OPENING EXPERIENCE — STYLES & LUXURY ANIMATIONS
   ========================================================================== */

.ribbon-opening-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EEE5F8;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
  perspective: 1200px;
  touch-action: none;
  overscroll-behavior: contain;
}

/* Ambient Lavender Watercolor Backdrop */
.ribbon-ambient-backdrop {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background: 
    radial-gradient(circle at 50% 45%, #F7F2FD 0%, #EEE5F8 55%, #D8C4EC 100%);
  z-index: 1;
}

.ribbon-bg-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 50%, transparent 60%, rgba(115, 85, 141, 0.14) 100%);
}

.ribbon-bg-floral-tl {
  position: absolute;
  top: 0;
  left: 0;
  width: clamp(180px, 25vw, 360px);
  height: clamp(180px, 25vw, 360px);
  background-image: url('/jony-wedding/assets/decorations/lavender-wash-top-left.webp');
  background-size: contain;
  background-repeat: no-repeat;
  opacity: 0.85;
}

.ribbon-bg-floral-tr {
  position: absolute;
  top: 0;
  right: 0;
  width: clamp(180px, 22vw, 380px);
  aspect-ratio: 448 / 460;
  background-image: url('/jony-wedding/assets/decorations/lavender-corner-top-right.webp');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: top right;
  opacity: 0.95;
}

.ribbon-bg-floral-bl {
  position: absolute;
  bottom: 0;
  left: 0;
  width: clamp(180px, 22vw, 380px);
  aspect-ratio: 440 / 454;
  background-image: url('/jony-wedding/assets/decorations/lavender-corner-bottom-left.webp');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: bottom left;
  opacity: 0.95;
}

.ribbon-bg-floral-br {
  position: absolute;
  bottom: 0;
  right: 0;
  width: clamp(180px, 25vw, 360px);
  height: clamp(180px, 25vw, 360px);
  background-image: url('/jony-wedding/assets/decorations/lavender-wash-bottom-right.webp');
  background-size: contain;
  background-repeat: no-repeat;
  opacity: 0.85;
}

/* Skip Intro Button */
.ribbon-skip-intro-btn {
  position: absolute;
  top: 20px;
  right: 24px;
  z-index: 50;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(197, 165, 109, 0.5);
  color: #73558D;
  font-family: var(--font-serif-secondary, Georgia, serif);
  font-size: 0.78rem;
  letter-spacing: 0.16em;
  padding: 8px 18px;
  border-radius: 20px;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(115, 85, 141, 0.12);
  transition: all 0.25s ease;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.ribbon-skip-intro-btn:hover {
  background: #FFF;
  color: #432C56;
  border-color: #C5A56D;
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(115, 85, 141, 0.2);
}

@media (max-width: 768px) {
  .ribbon-skip-intro-btn {
    display: none !important;
  }
}

/* Main Ribbon Stage */
.ribbon-stage {
  position: absolute;
  inset: 0;
  width: 100vw;
  height: 100dvh;
  min-height: 100vh;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Invitation Card Panel (Underneath Ribbon) */
.ribbon-card-panel {
  position: absolute;
  inset: 0;
  width: 100vw;
  height: 100dvh;
  min-height: 100vh;
  background: radial-gradient(circle at 50% 50%, #FAF7FE 0%, #EEE5F8 55%, #D8C4EC 100%);
  border-radius: 0;
  box-shadow: none;
  border: none;
  overflow: hidden;
  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 1s ease;
}

.ribbon-card-frame {
  position: absolute;
  inset: 14px;
  border: 1px dashed rgba(190, 166, 214, 0.6);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.ribbon-card-watermark {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
  transform: translateY(12px);
  transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.8s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.phase-2-unwrapping .ribbon-card-watermark,
.phase-3-cover-open .ribbon-card-watermark {
  opacity: 1 !important;
  visibility: visible !important;
  transform: translateY(0);
}

.ribbon-invited-header {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 2px;
}

.ribbon-invited-text {
  font-family: var(--font-serif-primary, 'Cinzel', serif);
  font-size: clamp(0.95rem, 2.2vw, 1.4rem);
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #55346E; /* Deep mauve / plum */
  text-shadow: 0 1px 2px rgba(197, 165, 109, 0.45);
  opacity: 0.85;
}

.ribbon-invited-flourish {
  color: #C5A56D; /* Champagne gold */
  font-size: 0.9rem;
  opacity: 0.8;
}

.ribbon-card-monogram {
  font-size: clamp(3.2rem, 9vw, 5.2rem);
  color: #73558D;
  line-height: 1;
  opacity: 0.35;
}

.ribbon-card-subtitle {
  font-size: clamp(0.65rem, 1.4vw, 0.8rem);
  letter-spacing: 0.24em;
  color: #9B7CB8;
  opacity: 0.45;
}

/* Scripture & Covenant Section (Unopened Ribbon Screen) */
.ribbon-scripture-container {
  position: absolute;
  top: clamp(28px, 6.5vh, 72px);
  left: 50%;
  transform: translateX(-50%);
  width: min(92%, 460px);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  z-index: 25;
  pointer-events: none;
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.ribbon-scripture-verse {
  font-family: var(--font-serif-secondary, 'EB Garamond', Georgia, serif);
  font-style: italic;
  font-size: clamp(0.96rem, 2.7vw, 1.3rem);
  line-height: 1.35;
  color: #4A2E63; /* Deep royal plum */
  margin: 0 0 3px 0;
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.ribbon-scripture-ref {
  font-family: var(--font-serif-secondary, 'EB Garamond', Georgia, serif);
  font-size: clamp(0.70rem, 1.8vw, 0.82rem);
  font-style: italic;
  letter-spacing: 0.12em;
  color: #7D5C96; /* Muted lavender */
  margin-bottom: 6px;
}

.ribbon-scripture-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: clamp(100px, 22vw, 160px);
  margin-bottom: 6px;
}

.ribbon-scripture-divider .scripture-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, #C5A56D, transparent);
}

.ribbon-scripture-divider .scripture-sparkle {
  color: #C5A56D;
  font-size: 0.7rem;
  line-height: 1;
}

.ribbon-covenant-text {
  font-family: var(--font-serif-primary, 'Cinzel', serif);
  font-size: clamp(0.68rem, 1.9vw, 0.85rem);
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #432C56; /* Rich deep plum */
  margin: 0;
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.6);
}

/* Fade out scripture smoothly when ribbon opening begins */
.phase-1-loosening .ribbon-scripture-container,
.phase-2-unwrapping .ribbon-scripture-container,
.phase-3-cover-open .ribbon-scripture-container,
.phase-4-reveal .ribbon-scripture-container {
  opacity: 0;
  transform: translateX(-50%) translateY(-15px);
}

/* Decorative Stickers Layer */
.ribbon-stickers-layer {
  position: absolute;
  inset: -15px;
  pointer-events: none;
  z-index: 15;
}

.wedding-sticker {
  position: absolute;
  filter: drop-shadow(0 6px 12px rgba(95, 65, 120, 0.22));
  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease;
}

.sticker-flower-1 {
  top: clamp(12%, 18vh, 22%);
  left: clamp(8%, 14vw, 20%);
  animation: stickerFloat 4.5s ease-in-out infinite alternate;
}

.sticker-heart-seal {
  top: clamp(12%, 18vh, 22%);
  right: clamp(8%, 14vw, 20%);
  animation: stickerSealGlow 3.6s ease-in-out infinite alternate;
}

.sticker-sprig-1 {
  bottom: clamp(14%, 20vh, 24%);
  left: clamp(8%, 14vw, 20%);
  animation: stickerFloat 5s ease-in-out infinite alternate;
}

.sticker-botanical-gold {
  bottom: clamp(14%, 20vh, 24%);
  right: clamp(8%, 14vw, 20%);
  animation: stickerFloat 4.8s ease-in-out infinite alternate-reverse;
}

@keyframes stickerFloat {
  0% { transform: translateY(0) rotate(0deg); }
  100% { transform: translateY(-7px) rotate(3deg); }
}

/* Ribbon Interactive Wrapper */
.ribbon-interactive-wrap {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  outline: none;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}

.ribbon-interactive-wrap:active .bow-center-seal,
.ribbon-interactive-wrap.is-pressed .bow-center-seal {
  transform: translate(-50%, -50%) scale(0.94);
  transition: transform 0.1s ease;
}

.ribbon-interactive-wrap:active .ribbon-tap-pill,
.ribbon-interactive-wrap.is-pressed .ribbon-tap-pill {
  transform: scale(0.95);
  transition: transform 0.1s ease;
}

/* Satin Ribbon Bands */
.ribbon-band {
  position: absolute;
  overflow: hidden;
  box-shadow: 
    0 8px 24px rgba(85, 55, 110, 0.28),
    inset 0 1px 2px rgba(255, 255, 255, 0.5),
    inset 0 -1px 2px rgba(67, 44, 86, 0.4);
  transition: transform 1.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.8s ease;
}

.ribbon-band-horizontal {
  left: 0;
  right: 0;
  top: 50%;
  width: 100vw;
  height: clamp(52px, 7vw, 76px);
  transform: translateY(-50%);
  background: linear-gradient(
    to bottom,
    #B295CE 0%,
    #D2BFE5 25%,
    #BEA6D6 50%,
    #AA8CC8 75%,
    #8A6B9F 100%
  );
  border-top: 1px solid rgba(255, 255, 255, 0.45);
  border-bottom: 1px solid rgba(115, 85, 141, 0.45);
}

.ribbon-band-vertical {
  top: 0;
  bottom: 0;
  left: 50%;
  width: clamp(52px, 7vw, 76px);
  height: 100dvh;
  min-height: 100vh;
  transform: translateX(-50%);
  background: linear-gradient(
    to right,
    #B295CE 0%,
    #D2BFE5 25%,
    #BEA6D6 50%,
    #AA8CC8 75%,
    #8A6B9F 100%
  );
  border-left: 1px solid rgba(255, 255, 255, 0.45);
  border-right: 1px solid rgba(115, 85, 141, 0.45);
}

/* Subtle Satin Ribbon Shimmer */
.ribbon-shimmer-highlight {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    115deg,
    transparent 0%,
    transparent 35%,
    rgba(255, 255, 255, 0.35) 50%,
    transparent 65%,
    transparent 100%
  );
  background-size: 200% 200%;
  animation: ribbonShimmer 5s ease-in-out infinite;
  pointer-events: none;
}

@keyframes ribbonShimmer {
  0% { background-position: -150% -150%; }
  35% { background-position: 150% 150%; }
  100% { background-position: 150% 150%; }
}

/* Center Satin Bow Assembly */
.ribbon-bow-assembly {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: clamp(170px, 30vw, 240px);
  height: clamp(150px, 26vw, 210px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 25;
  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.8s ease;
}

/* Bow Loops */
.bow-loop {
  position: absolute;
  top: 15px;
  width: clamp(75px, 14vw, 110px);
  height: clamp(65px, 12vw, 95px);
  background: radial-gradient(ellipse at 40% 40%, #E2D3F2 0%, #BEA6D6 45%, #9273B0 100%);
  box-shadow: 
    0 12px 24px rgba(75, 45, 95, 0.32),
    inset 0 2px 4px rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(197, 165, 109, 0.4);
  transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease;
}

.bow-loop-left {
  left: 0;
  border-radius: 50% 15% 50% 45%;
  transform: rotate(-16deg);
  transform-origin: right center;
}

.bow-loop-right {
  right: 0;
  border-radius: 15% 50% 45% 50%;
  transform: rotate(16deg);
  transform-origin: left center;
}

.bow-loop-fold {
  position: absolute;
  inset: 10px;
  border-radius: inherit;
  background: radial-gradient(ellipse at center, rgba(115, 85, 141, 0.35) 0%, transparent 70%);
}

/* Bow Tails */
.bow-tail {
  position: absolute;
  top: 65px;
  width: clamp(38px, 7vw, 52px);
  height: clamp(70px, 13vw, 100px);
  background: linear-gradient(to bottom, #BEA6D6 0%, #9B7CB8 70%, #73558D 100%);
  box-shadow: 0 10px 20px rgba(75, 45, 95, 0.25);
  border: 1px solid rgba(197, 165, 109, 0.35);
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 85%, 0 100%);
  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease;
}

.bow-tail-left {
  left: clamp(24px, 5vw, 42px);
  transform: rotate(12deg);
  transform-origin: top center;
}

.bow-tail-right {
  right: clamp(24px, 5vw, 42px);
  transform: rotate(-12deg);
  transform-origin: top center;
}

/* Center Royal Lavender-Compatible Crest Medallion Knot */
.bow-center-seal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: clamp(86px, 15vw, 114px);
  height: clamp(86px, 15vw, 114px);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #73558D 0%, #55346E 60%, #3C234E 100%);
  box-shadow: 
    0 12px 32px rgba(50, 25, 70, 0.45),
    0 2px 8px rgba(197, 165, 109, 0.4),
    inset 0 2px 4px rgba(255, 255, 255, 0.25);
  border: 2px solid #C5A56D;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease;
  box-sizing: border-box;
}

.seal-gold-inner-disc {
  width: 86%;
  height: 86%;
  border-radius: 50%;
  border: 1px dashed rgba(197, 165, 109, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at center, rgba(115, 85, 141, 0.35) 0%, rgba(85, 52, 110, 0.75) 100%);
  box-sizing: border-box;
}

.seal-crest-img {
  width: 82%;
  height: 82%;
  object-fit: contain;
  filter: drop-shadow(0 2px 4px rgba(20, 10, 30, 0.5));
}

/* Tap to Open Prompt */
.ribbon-prompt-container {
  position: absolute;
  bottom: clamp(24px, 5vh, 48px);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 90%;
  pointer-events: auto;
  cursor: pointer;
  z-index: 25;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.ribbon-tap-pill {
  cursor: pointer;
  pointer-events: auto;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 24px;
  border-radius: 30px;
  background: rgba(255, 255, 255, 0.92);
  border: 1.5px solid rgba(197, 165, 109, 0.65);
  color: #55346E;
  box-shadow: 
    0 8px 24px rgba(115, 85, 141, 0.2),
    0 2px 6px rgba(197, 165, 109, 0.25);
  animation: tapPillPulse 2.8s ease-in-out infinite;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.ribbon-sparkle-icon {
  color: #C5A56D;
  font-size: 0.85rem;
  animation: sparkleTwinkle 2s ease-in-out infinite alternate;
}

.ribbon-prompt-text {
  font-size: clamp(0.74rem, 1.3vw, 0.88rem);
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.ribbon-sub-caption {
  font-family: var(--font-serif-secondary, Georgia, serif);
  font-size: clamp(0.72rem, 1.2vw, 0.82rem);
  font-style: italic;
  color: #73558D;
  text-align: center;
  margin: 0;
}

@keyframes tapPillPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 8px 24px rgba(115, 85, 141, 0.2); }
  50% { transform: scale(1.03); box-shadow: 0 12px 28px rgba(197, 165, 109, 0.35); }
}

@keyframes sparkleTwinkle {
  0% { transform: scale(0.85) rotate(0deg); opacity: 0.7; }
  100% { transform: scale(1.15) rotate(35deg); opacity: 1; }
}

/* Light Bloom for Transition */
.ribbon-light-bloom {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(247, 242, 253, 0.95) 0%, rgba(238, 229, 248, 0.85) 50%, rgba(216, 196, 236, 0.9) 100%);
  opacity: 0;
  pointer-events: none;
  z-index: 60;
  transition: opacity 0.8s ease;
}

/* ==========================================================================
   ANIMATION PHASES (Triggered via JavaScript on Tap)
   ========================================================================== */

/* Phase 1 — Ribbon loosens (0 - 0.8s) */
.phase-1-loosening .bow-center-seal {
  transform: translate(-50%, -50%) scale(1.15);
  box-shadow: 0 16px 36px rgba(197, 165, 109, 0.45);
}

.phase-1-loosening .bow-loop-left {
  transform: rotate(-26deg) scale(1.08);
}

.phase-1-loosening .bow-loop-right {
  transform: rotate(26deg) scale(1.08);
}

.phase-1-loosening .ribbon-prompt-container {
  opacity: 0;
  transform: translateX(-50%) translateY(10px);
}

/* Phase 2 — Ribbon unwraps (0.8s - 2.4s) */
.phase-2-unwrapping .bow-center-seal {
  transform: translate(-50%, -50%) scale(0.6) rotate(20deg);
  opacity: 0;
  transition: transform 0.9s cubic-bezier(0.55, 0, 1, 0.45), opacity 0.7s ease;
}

.phase-2-unwrapping .bow-loop-left {
  transform: translate(-140vw, -30vh) rotate(-70deg) scale(0.8);
  opacity: 0;
  transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 1s ease;
}

.phase-2-unwrapping .bow-loop-right {
  transform: translate(140vw, -30vh) rotate(70deg) scale(0.8);
  opacity: 0;
  transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 1s ease;
}

.phase-2-unwrapping .bow-tail-left {
  transform: translate(-120vw, 40vh) rotate(-45deg);
  opacity: 0;
  transition: transform 1.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 1s ease;
}

.phase-2-unwrapping .bow-tail-right {
  transform: translate(120vw, 40vh) rotate(45deg);
  opacity: 0;
  transition: transform 1.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 1s ease;
}

.phase-2-unwrapping .ribbon-band-horizontal {
  transform: translateY(-50%) scaleX(0);
  opacity: 0;
  transition: transform 1.1s cubic-bezier(0.55, 0, 1, 0.45), opacity 0.9s ease;
}

.phase-2-unwrapping .ribbon-band-vertical {
  transform: translateX(-50%) scaleY(0);
  opacity: 0;
  transition: transform 1.1s cubic-bezier(0.55, 0, 1, 0.45), opacity 0.9s ease;
}

.phase-2-unwrapping .wedding-sticker {
  transform: scale(0.85);
  opacity: 0.3;
  transition: transform 0.8s ease, opacity 0.8s ease;
}

/* Phase 3 — Invitation cover opens & light bloom (2.4s - 3.4s) */
.phase-3-cover-open .ribbon-card-panel {
  transform: scale(1.08) translateY(-15px);
  opacity: 0;
  transition: transform 0.9s ease, opacity 0.9s ease;
}

.phase-3-cover-open .wedding-sticker {
  opacity: 0;
  transform: scale(0.5);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.phase-3-cover-open .ribbon-light-bloom {
  opacity: 1;
  transition: opacity 0.7s ease;
}

/* Phase 4 — Reveal actual website (3.4s - 4.2s) */
.phase-4-reveal {
  opacity: 0;
  transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

/* Reduced Motion Mode */
@media (prefers-reduced-motion: reduce) {
  .ribbon-shimmer-highlight,
  .wedding-sticker,
  .ribbon-tap-pill,
  .ribbon-sparkle-icon {
    animation: none !important;
  }
}
</style>

<script>
  function initRibbonExperience() {
    const overlay = document.getElementById("ribbon-opening-overlay");
    const interactiveWrap = document.getElementById("ribbon-interactive-wrap");
    const skipBtn = document.getElementById("ribbon-skip-intro-btn");
    const siteMain = document.getElementById("wedding-site");

    if (!overlay) return;

    let isOpening = false;
    let hasDismissed = false;

    function lockScroll() {
      document.documentElement.classList.add("scroll-locked");
      document.body.classList.add("scroll-locked");
    }

    function unlockScroll() {
      document.documentElement.classList.remove("scroll-locked");
      document.body.classList.remove("scroll-locked");
      document.body.style.removeProperty("overflow");
      document.documentElement.style.removeProperty("overflow");
      document.body.style.removeProperty("overflow-y");
      document.documentElement.style.removeProperty("overflow-y");
      document.body.style.removeProperty("touch-action");
      document.documentElement.style.removeProperty("touch-action");
      document.body.style.removeProperty("overscroll-behavior-y");
      document.documentElement.style.removeProperty("overscroll-behavior-y");
      document.body.style.removeProperty("overscroll-behavior");
      document.documentElement.style.removeProperty("overscroll-behavior");
    }

    // Ensure clean reset on page refresh / load: an intentional page refresh resets ribbon opening
    try {
      sessionStorage.removeItem("wedding_ribbon_dismissed");
    } catch (e) {}

    // Lock page scrolling while unopened ribbon overlay is active
    lockScroll();

    // Prime audio element immediately on page load
    const bgmAudio = document.getElementById("wedding-bgm-audio") as HTMLAudioElement | null;
    if (bgmAudio) {
      bgmAudio.volume = 0.45;
      const primeOffset = () => {
        if (bgmAudio.currentTime < 0.46) {
          try { bgmAudio.currentTime = 0.46; } catch (e) {}
        }
      };
      if (bgmAudio.readyState >= 1) {
        primeOffset();
      } else {
        bgmAudio.addEventListener("loadedmetadata", primeOffset, { once: true, passive: true });
        bgmAudio.addEventListener("canplay", primeOffset, { once: true, passive: true });
      }
    }

    // Synchronously trigger audio on trusted user interaction
    function triggerAudioImmediate() {
      try {
        const audio = (document.getElementById("wedding-bgm-audio") as HTMLAudioElement) || (window as any).__weddingAudio;
        if (audio) {
          if (audio.currentTime < 0.46) {
            try { audio.currentTime = 0.46; } catch (e) {}
          }
          audio.volume = 0.45;
          const p = audio.play();
          if (p && typeof p.catch === "function") {
            p.catch((err) => {
              console.warn("Audio autoplay blocked by browser:", err);
            });
          }
        }
        const w = window as any;
        if (w.__weddingMusicController && typeof w.__weddingMusicController.play === "function") {
          w.__weddingMusicController.play();
        }
      } catch (err) {}
    }

    function startRibbonOpening() {
      if (isOpening || hasDismissed) return;
      isOpening = true;

      window.dispatchEvent(new CustomEvent("wedding-ribbon-start-opening"));

      // Phase 1 — Ribbon loosens (0.0s - 0.8s)
      overlay.classList.add("phase-1-loosening");

      // Phase 2 — Ribbon unwraps (0.8s - 2.2s)
      setTimeout(() => {
        if (hasDismissed) return;
        overlay.classList.add("phase-2-unwrapping");
      }, 750);

      // Phase 3 — Cover opens & light bloom (2.2s - 3.2s)
      setTimeout(() => {
        if (hasDismissed) return;
        overlay.classList.add("phase-3-cover-open");
        overlay.style.pointerEvents = "none";
        unlockScroll();
      }, 2200);

      // Phase 4 — Reveal actual website (3.2s - 4.0s)
      setTimeout(() => {
        if (hasDismissed) return;
        overlay.classList.add("phase-4-reveal");
        overlay.style.pointerEvents = "none";
        if (siteMain) {
          siteMain.classList.add("wedding-site-revealed");
          siteMain.style.visibility = "visible";
        }
        unlockScroll();
        window.dispatchEvent(new CustomEvent("wedding-ribbon-opened"));
      }, 3200);

      // Complete unmount at ~4.0s
      setTimeout(() => {
        dismissImmediately();
      }, 4000);

      // Hard failsafe at 4.5s to guarantee dismissal and scroll unlock
      setTimeout(() => {
        if (!hasDismissed) {
          dismissImmediately();
        }
      }, 4500);
    }

    function cleanupListeners() {
      interactiveWrap?.removeEventListener("pointerdown", onTrigger);
      interactiveWrap?.removeEventListener("click", onTrigger);
      interactiveWrap?.removeEventListener("touchend", onTrigger);
      overlay?.removeEventListener("click", onTrigger);
      window.removeEventListener("keydown", onKeydown);
    }

    function dismissImmediately() {
      if (hasDismissed) return;
      hasDismissed = true;
      cleanupListeners();
      unlockScroll();
      overlay.style.display = "none";
      overlay.style.pointerEvents = "none";
      overlay.style.visibility = "hidden";
      overlay.setAttribute("aria-hidden", "true");
      try {
        overlay.remove();
      } catch (e) {}
      if (siteMain) {
        siteMain.classList.add("wedding-site-revealed");
        siteMain.style.visibility = "visible";
      }
      window.dispatchEvent(new CustomEvent("wedding-ribbon-opened"));
      window.dispatchEvent(new CustomEvent("wedding-envelope-opened"));
    }

    function onTrigger(e: Event) {
      if ((e.target as HTMLElement)?.closest("#ribbon-skip-intro-btn")) return;
      // Start audio immediately in the direct call stack of the user gesture
      triggerAudioImmediate();
      interactiveWrap?.classList.add("is-pressed");
      startRibbonOpening();
    }

    // Direct, immediate pointer/touch activation with zero synthetic click delay
    interactiveWrap?.addEventListener("pointerdown", onTrigger, { once: true });
    interactiveWrap?.addEventListener("click", onTrigger, { once: true });
    interactiveWrap?.addEventListener("touchend", onTrigger, { once: true });
    overlay?.addEventListener("click", onTrigger);

    const tapPill = overlay?.querySelector(".ribbon-tap-pill");
    tapPill?.addEventListener("click", onTrigger);
    tapPill?.addEventListener("pointerdown", onTrigger);

    // Skip intro button
    skipBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      dismissImmediately();
    });

    // Keyboard support: Enter / Space to open, Escape to skip
    function onKeydown(e: KeyboardEvent) {
      if (hasDismissed) return;
      if (e.key === "Escape") {
        dismissImmediately();
      } else if (!isOpening && (e.key === "Enter" || e.key === " ")) {
        e.preventDefault();
        startRibbonOpening();
      }
    }
    window.addEventListener("keydown", onKeydown);

    // Handle replay event if requested
    window.addEventListener("wedding-replay-ribbon-opening", () => {
      try {
        sessionStorage.removeItem("wedding_ribbon_dismissed");
      } catch (e) {}
      overlay.classList.remove(
        "phase-1-loosening",
        "phase-2-unwrapping",
        "phase-3-cover-open",
        "phase-4-reveal"
      );
      overlay.style.display = "flex";
      document.body.style.overflow = "hidden";
      isOpening = false;
      hasDismissed = false;
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRibbonExperience);
  } else {
    initRibbonExperience();
  }
</script>
