---
interface ClosingData {
  heading: string;
  message: string;
  signature: string;
  hosts: string;
}

interface Props {
  closing: ClosingData;
  monogram: string;
}

const { closing, monogram } = Astro.props;
---

<section id="closing-section" class="invite-section reveal-on-scroll">
  <!-- Dedicated Lavender 4-Corner Accent Layer -->
  <div class="lavender-section-decor" aria-hidden="true">
    <div class="lavender-corner-item lavender-corner-tl"></div>
    <div class="lavender-corner-item lavender-corner-tr"></div>
    <div class="lavender-corner-item lavender-corner-bl"></div>
    <div class="lavender-corner-item lavender-corner-br"></div>
  </div>

  <div class="closing-card-container">
    <div class="closing-stationery-card">
      <span class="closing-monogram font-script">
        {monogram}
      </span>

      <h2 class="closing-heading font-serif">{closing.heading}</h2>

      <div class="botanical-divider" style="max-width: 160px; margin: 6px auto 18px;">
        <span class="botanical-divider-icon">❦</span>
      </div>

      <p class="closing-message-text">{closing.message}</p>

      <p class="closing-signature-text font-script">{closing.signature}</p>
      <p class="closing-family-hosts font-serif">{closing.hosts}</p>
    </div>
  </div>
</section>