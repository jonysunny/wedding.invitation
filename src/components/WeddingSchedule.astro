---
// WeddingSchedule.astro
// Premium Lavender Floral Wedding Schedule - Matching User's Mockup Design
// Features unified rounded lavender cards, central winding botanical creeper, and scroll-controlled solid purple heart

interface ScheduleEvent {
  time: string;
  title: string;
  subtitle?: string;
  highlight?: boolean;
}

const scheduleEvents: ScheduleEvent[] = [
  {
    time: "4:00 PM",
    title: "Groom Entry"
  },
  {
    time: "4:10 PM",
    title: "Songs"
  },
  {
    time: "4:30 PM",
    title: "Bride Entry"
  },
  {
    time: "4:45 PM",
    title: "God's Word",
    subtitle: "Dr. P. John Paul"
  },
  {
    time: "5:30 PM",
    title: "Wedding Ceremony",
    subtitle: "Rev. Dr. K. Daniel Solomon",
    highlight: true
  },
  {
    time: "6:10 PM",
    title: "Prayer",
    subtitle: "By all servants of God"
  },
  {
    time: "6:20 PM",
    title: "Wedding Greetings"
  },
  {
    time: "6:50 PM",
    title: "Couple Walk Along the Aisle"
  },
  {
    time: "7:00 PM",
    title: "Closing Prayer",
    subtitle: "Followed by Reception & Dinner at 9 Convention Hall",
    highlight: true
  }
];
---

<section id="wedding-schedule-section" class="invite-section wedding-schedule-page reveal-on-scroll">
  <!-- Dedicated Lavender 4-Corner Accent Layer -->
  <div class="lavender-section-decor decor-comp-schedule" aria-hidden="true">
    <div class="lavender-corner-item lavender-corner-tl"></div>
    <div class="lavender-corner-item lavender-corner-tr"></div>
    <div class="lavender-corner-item lavender-corner-bl"></div>
    <div class="lavender-corner-item lavender-corner-br"></div>
  </div>

  <!-- Perimeter Luxury Double Border Inset -->
  <div class="invitation-page-border" aria-hidden="true">
    <div class="invitation-page-inner-border"></div>
  </div>
  <div class="invitation-corner-ornaments" aria-hidden="true">
    <span class="corner-ornament corner-top-left">❦</span>
    <span class="corner-ornament corner-top-right">❦</span>
    <span class="corner-ornament corner-bottom-left">❦</span>
    <span class="corner-ornament corner-bottom-right">❦</span>
  </div>

  <div class="schedule-content-container">
    <!-- Main Stationery Panel matching user's reference mockup -->
    <div class="page-invitation-card schedule-mockup-panel stationery-panel">
      <!-- Mockup Section Header -->
      <div class="schedule-mockup-header">
        <h2 class="schedule-mockup-title font-serif">Wedding Schedule</h2>
      </div>

      <div class="schedule-mockup-timeline-wrap" id="schedule-split-timeline">
        <!-- Winding Botanical Creeper Corridor passing between Time and Event columns -->
        <div class="schedule-mockup-creeper-wrapper" id="schedule-creeper-wrapper" aria-hidden="true">
          <svg class="schedule-mockup-creeper-svg" id="schedule-creeper-svg" viewBox="0 0 50 1000" preserveAspectRatio="none">
            <defs>
              <linearGradient id="mockupStemGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="rgba(182, 157, 207, 0.55)" />
                <stop offset="50%" stop-color="rgba(165, 137, 194, 0.70)" />
                <stop offset="100%" stop-color="rgba(135, 102, 168, 0.85)" />
              </linearGradient>
              <linearGradient id="mockupGlowGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#C5A56D" />
                <stop offset="30%" stop-color="#A57ECC" />
                <stop offset="70%" stop-color="#835BA3" />
                <stop offset="100%" stop-color="#552F7A" />
              </linearGradient>
              <filter id="mockupGlowFilter" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <!-- Base Winding Creeper Stem -->
            <path 
              class="mockup-stem-base" 
              id="creeper-stem-base"
              d="M 25 15 C 33 75, 17 135, 25 195 C 33 255, 17 315, 25 375 C 33 435, 17 495, 25 555 C 33 615, 17 675, 25 735 C 33 795, 17 855, 25 915 C 30 955, 25 985, 25 985" 
              fill="none" 
              stroke="url(#mockupStemGrad)" 
              stroke-width="2.6" 
              stroke-linecap="round"
            />

            <!-- Organic Leaf Pairs along the vine curves (matching mockup reference) -->
            <!-- Pair 1 -->
            <path class="mockup-leaf" d="M 25 108 C 30 102, 39 104, 41 110 C 39 114, 30 114, 25 108 Z" fill="#B8A0CE" opacity="0.85" />
            <path class="mockup-leaf" d="M 24 113 C 19 108, 10 111, 8 117 C 11 120, 20 118, 24 113 Z" fill="#B8A0CE" opacity="0.85" />

            <!-- Pair 2 -->
            <path class="mockup-leaf" d="M 25 288 C 30 282, 39 284, 41 290 C 39 294, 30 294, 25 288 Z" fill="#B8A0CE" opacity="0.85" />
            <path class="mockup-leaf" d="M 24 293 C 19 288, 10 291, 8 297 C 11 300, 20 298, 24 293 Z" fill="#B8A0CE" opacity="0.85" />

            <!-- Pair 3 -->
            <path class="mockup-leaf" d="M 25 468 C 30 462, 39 464, 41 470 C 39 474, 30 474, 25 468 Z" fill="#B8A0CE" opacity="0.85" />
            <path class="mockup-leaf" d="M 24 473 C 19 468, 10 471, 8 477 C 11 480, 20 478, 24 473 Z" fill="#B8A0CE" opacity="0.85" />

            <!-- Pair 4 -->
            <path class="mockup-leaf" d="M 25 648 C 30 642, 39 644, 41 650 C 39 654, 30 654, 25 648 Z" fill="#B8A0CE" opacity="0.85" />
            <path class="mockup-leaf" d="M 24 653 C 19 648, 10 651, 8 657 C 11 660, 20 658, 24 653 Z" fill="#B8A0CE" opacity="0.85" />

            <!-- Pair 5 -->
            <path class="mockup-leaf" d="M 25 828 C 30 822, 39 824, 41 830 C 39 834, 30 834, 25 828 Z" fill="#B8A0CE" opacity="0.85" />
            <path class="mockup-leaf" d="M 24 833 C 19 828, 10 831, 8 837 C 11 840, 20 838, 24 833 Z" fill="#B8A0CE" opacity="0.85" />

            <!-- Active Illuminated Stem Glow -->
            <path 
              class="mockup-stem-glow" 
              id="creeper-stem-glow"
              d="M 25 15 C 33 75, 17 135, 25 195 C 33 255, 17 315, 25 375 C 33 435, 17 495, 25 555 C 33 615, 17 675, 25 735 C 33 795, 17 855, 25 915 C 30 955, 25 985, 25 985" 
              fill="none" 
              stroke="url(#mockupGlowGrad)" 
              stroke-width="3.2" 
              stroke-linecap="round"
              filter="url(#mockupGlowFilter)"
            />
          </svg>

          <!-- Solid Rich Purple Heart with Soft Glowing Halo (exact match to reference mockup) -->
          <div class="mockup-travelling-heart" id="schedule-travelling-heart" aria-hidden="true">
            <svg class="mockup-heart-svg" viewBox="0 0 32 32" width="32" height="32">
              <defs>
                <radialGradient id="mockupHeartAura" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="rgba(131, 91, 163, 0.85)" />
                  <stop offset="60%" stop-color="rgba(165, 126, 204, 0.40)" />
                  <stop offset="100%" stop-color="rgba(165, 126, 204, 0)" />
                </radialGradient>
              </defs>
              <!-- Outer glowing aura -->
              <circle cx="16" cy="16" r="15" fill="url(#mockupHeartAura)" />
              <!-- Solid Rich Purple Heart -->
              <path 
                d="M16 26 C16 26 5.5 18.5 5.5 11.5 C5.5 8 8 5.5 11.2 5.5 C13.3 5.5 14.8 6.6 16 8 C17.2 6.6 18.7 5.5 20.8 5.5 C24 5.5 26.5 8 26.5 11.5 C26.5 18.5 16 26 16 26 Z" 
                fill="#835BA3" 
                stroke="rgba(255, 255, 255, 0.4)" 
                stroke-width="0.6"
              />
            </svg>
          </div>
        </div>

        <!-- Schedule Event Rows: Unified Rounded Lavender Cards -->
        <div class="schedule-mockup-rows" id="split-timeline-rows">
          {scheduleEvents.map((item, index) => (
            <div 
              class={`mockup-event-row ${item.highlight ? 'is-highlighted-event' : ''}`} 
              data-step={index + 1}
              id={`schedule-row-${index + 1}`}
            >
              <!-- Left Column: Time -->
              <div class="mockup-row-time">
                <span class="mockup-time-text font-serif">{item.time}</span>
              </div>

              <!-- Corridor Spacer: Where Creeper passes -->
              <div class="mockup-row-spacer" aria-hidden="true"></div>

              <!-- Right Column: Event Title & Subtitle -->
              <div class="mockup-row-content">
                <h3 class="mockup-event-title font-serif">{item.title}</h3>
                {item.subtitle && (
                  <p class="mockup-event-subtitle font-serif-sub">{item.subtitle}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // High-Performance 60 FPS Scroll-Controlled Travelling Heart on Central Creeper
  (function initMockupCreeperHeart() {
    function setup() {
      const section = document.getElementById('wedding-schedule-section');
      const scheduleTimeline = document.getElementById('schedule-split-timeline');
      const creeperSvg = document.getElementById('schedule-creeper-svg');
      const creeperBase = document.getElementById('creeper-stem-base');
      const creeperGlow = document.getElementById('creeper-stem-glow');
      const heart = document.getElementById('schedule-travelling-heart');
      const rows = document.querySelectorAll('.mockup-event-row');

      if (!section || !scheduleTimeline || !creeperBase || !creeperGlow || !heart || rows.length === 0) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Cache total path length
      let pathLength = 0;
      try {
        pathLength = creeperBase.getTotalLength();
      } catch (e) {
        pathLength = 1000;
      }

      // Initialize glow path dasharray to match path length
      creeperGlow.style.strokeDasharray = pathLength + ' ' + pathLength;
      creeperGlow.style.strokeDashoffset = pathLength;

      let ticking = false;
      let isListeningScroll = false;
      let cachedTimelineTopDoc = 0;
      let cachedTimelineHeight = 0;
      let cachedCorridorWidth = 36;
      let cachedVh = window.innerHeight || 800;
      let cachedRowTops = [];
      let cachedFirstRowMid = 20;
      let cachedLastRowMid = 980;
      let cachedTravelSpan = 960;
      let lastActiveIndex = -2;
      let lastPassedIndex = -2;

      function updateMeasurements() {
        if (!scheduleTimeline) return;
        cachedVh = window.innerHeight || document.documentElement.clientHeight || 800;
        const timelineRect = scheduleTimeline.getBoundingClientRect();
        const currentScrollY = window.scrollY || window.pageYOffset || 0;
        cachedTimelineTopDoc = timelineRect.top + currentScrollY;
        cachedTimelineHeight = timelineRect.height || 1000;
        cachedCorridorWidth = creeperSvg?.clientWidth || 36;
        
        cachedRowTops = Array.from(rows).map(function(row) {
          const r = row.getBoundingClientRect();
          return {
            element: row,
            top: (r.top + currentScrollY) - cachedTimelineTopDoc,
            mid: (r.top + currentScrollY + r.height / 2) - cachedTimelineTopDoc
          };
        });

        if (cachedRowTops.length > 0) {
          cachedFirstRowMid = cachedRowTops[0].mid;
          cachedLastRowMid = cachedRowTops[cachedRowTops.length - 1].mid;
          cachedTravelSpan = cachedLastRowMid - cachedFirstRowMid;
        }
      }

      function updateHeartPosition() {
        ticking = false;
        const scrollY = window.scrollY || window.pageYOffset || 0;
        const timelineTop = cachedTimelineTopDoc - scrollY;
        const timelineBottom = timelineTop + cachedTimelineHeight;

        // Fast skip if schedule is not in active viewport area
        if (timelineBottom < -100 || timelineTop > cachedVh + 100) {
          return;
        }

        // Target trigger line: center of screen (vh * 0.5)
        const triggerY = cachedVh * 0.50;
        const currentY = triggerY - timelineTop;

        let progress = 0;
        if (cachedTravelSpan > 0) {
          progress = (currentY - cachedFirstRowMid) / cachedTravelSpan;
        }
        // Strict clamping: stays precisely within first event and last event
        progress = Math.max(0, Math.min(1, progress));

        if (prefersReducedMotion) {
          heart.style.opacity = '1';
          return;
        }

        // Get exact (x, y) along the curved SVG path
        const point = creeperBase.getPointAtLength(pathLength * progress);

        // Map SVG viewBox (width 50) coordinates to actual pixel container dimensions:
        const xOffsetPx = ((point.x - 25) / 50) * cachedCorridorWidth;
        
        // Vertical position: smoothly mapped from firstRowMid to lastRowMid
        const yOffsetPx = cachedFirstRowMid + (progress * cachedTravelSpan);

        // Hardware-accelerated translate3d for 60 FPS motion with zero reflow
        heart.style.transform = 'translate3d(calc(-50% + ' + xOffsetPx.toFixed(1) + 'px), ' + (yOffsetPx - 16).toFixed(1) + 'px, 0)';
        heart.style.opacity = '1';

        // Update glowing trail behind heart
        const glowOffset = pathLength * (1 - progress);
        creeperGlow.style.strokeDashoffset = glowOffset.toFixed(1);

        // Highlight the row nearest to current heart position with batched DOM updates
        let closestIndex = -1;
        let minDiff = Infinity;
        let passedIndex = -1;
        for (let i = 0; i < cachedRowTops.length; i++) {
          const diff = Math.abs(cachedRowTops[i].mid - yOffsetPx);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = i;
          }
          if (cachedRowTops[i].mid <= yOffsetPx + 15) {
            passedIndex = i;
          }
        }

        // Only modify DOM classList when active or passed index changes to avoid style invalidations
        if (closestIndex !== lastActiveIndex || passedIndex !== lastPassedIndex) {
          lastActiveIndex = closestIndex;
          lastPassedIndex = passedIndex;

          for (let i = 0; i < rows.length; i++) {
            if (i === closestIndex && minDiff < 85) {
              rows[i].classList.add('is-active-event');
            } else {
              rows[i].classList.remove('is-active-event');
            }

            if (i <= passedIndex) {
              rows[i].classList.add('is-passed');
            } else {
              rows[i].classList.remove('is-passed');
            }
          }
        }
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(updateHeartPosition);
          ticking = true;
        }
      }

      function attachScrollListener() {
        if (!isListeningScroll) {
          window.addEventListener('scroll', onScroll, { passive: true });
          isListeningScroll = true;
        }
      }

      function detachScrollListener() {
        if (isListeningScroll) {
          window.removeEventListener('scroll', onScroll);
          isListeningScroll = false;
        }
      }

      // IntersectionObserver: Only listen to scroll events when section is visible
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              updateMeasurements();
              attachScrollListener();
              onScroll();
            } else {
              detachScrollListener();
            }
          });
        }, { rootMargin: '300px 0px 300px 0px' });
        observer.observe(section);
      } else {
        attachScrollListener();
      }

      window.addEventListener('resize', () => {
        updateMeasurements();
        onScroll();
      }, { passive: true });

      const onAppReady = () => {
        updateMeasurements();
        updateHeartPosition();
      };

      window.addEventListener('wedding-ribbon-opened', onAppReady, { passive: true });
      window.addEventListener('wedding-ribbon-start-opening', onAppReady, { passive: true });
      window.addEventListener('wedding-envelope-opened', onAppReady, { passive: true });

      // Initial measurement and positioning
      updateMeasurements();
      updateHeartPosition();
      setTimeout(onAppReady, 250);
      setTimeout(onAppReady, 750);
      setTimeout(onAppReady, 1500);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
