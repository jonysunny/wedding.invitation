---
interface PhotoItem {
  url: string;
  title: string;
  caption: string;
  alt?: string;
}

interface Props {
  gallery: PhotoItem[];
}

const { gallery } = Astro.props;
---

<section id="photo-gallery" class="invite-section reveal-on-scroll">
  <!-- Dedicated Lavender 4-Corner Artwork Layer with Balanced Gallery Composition -->
  <div class="lavender-section-decor decor-comp-gallery" aria-hidden="true">
    <div class="lavender-corner-item lavender-corner-tl"></div>
    <div class="lavender-corner-item lavender-corner-tr"></div>
    <div class="lavender-corner-item lavender-corner-bl"></div>
    <div class="lavender-corner-item lavender-corner-br"></div>
  </div>

  <!-- Perimeter Luxury Double Border Inset -->
  <div class="invitation-page-border" aria-hidden="true">
    <div class="invitation-page-inner-border"></div>
  </div>
  <div class="invitation-corner-ornaments" aria-hidden="true">
    <span class="corner-ornament corner-top-left">❦</span>
    <span class="corner-ornament corner-top-right">❦</span>
    <span class="corner-ornament corner-bottom-left">❦</span>
    <span class="corner-ornament corner-bottom-right">❦</span>
  </div>

  <div class="section-heading-block">
    <span class="section-label">MEMORIES & SMILES</span>
    <h2 class="section-title">Cherished Moments</h2>
    <p class="section-desc">A glimpse into our beautiful journey and celebration of love</p>
  </div>

  <div class="botanical-divider" style="margin-bottom: 24px;">
    <span class="botanical-divider-icon">❦</span>
  </div>

  <div class="gallery-grid">
    {gallery.map((photo, index) => (
      <div 
        class="gallery-card" 
        data-index={index} 
        data-src={photo.url} 
        data-title={photo.title} 
        data-caption={photo.caption}
        data-alt={photo.alt || photo.title}
      >
        <img 
          src={photo.url} 
          alt={photo.alt || photo.title} 
          loading="lazy"
          decoding="async"
        />
        <div class="gallery-caption-bar">
          <p>{photo.title}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Interactive Lightbox Modal -->
  <div id="gallery-lightbox" class="lightbox-modal" role="dialog" aria-modal="true" aria-label="Photo Preview" aria-hidden="true">
    <button id="lightbox-close" class="lightbox-close-btn" aria-label="Close preview (Esc)">✕</button>

    <button id="lightbox-prev" class="lightbox-nav-btn lightbox-prev-btn" aria-label="Previous photo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button id="lightbox-next" class="lightbox-nav-btn lightbox-next-btn" aria-label="Next photo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
    
    <div class="lightbox-img-box">
      <img id="lightbox-preview-img" src="" alt="Enlarged photo preview" />
      <div class="lightbox-caption-wrap">
        <span id="lightbox-counter" class="lightbox-counter"></span>
        <h4 id="lightbox-preview-title" class="lightbox-preview-title"></h4>
        <p id="lightbox-preview-caption" class="lightbox-preview-caption"></p>
      </div>
    </div>
  </div>
</section>