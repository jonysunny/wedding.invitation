---
// EnvelopeOpeningExperience.astro
// Interactive Realistic Luxury Paper-Envelope Opening Experience
---

<div id="envelope-experience-overlay" class="envelope-overlay envelope-end-to-end" role="dialog" aria-modal="true" aria-label="Interactive Wedding Invitation Envelope">
  <!-- Ambient Warm Ivory Paper Backdrop with Subtle Vignette -->
  <div class="envelope-backdrop" aria-hidden="true"></div>

  <!-- Discreet Skip Option in Top-Right -->
  <button id="envelope-skip-btn" type="button" class="envelope-skip-btn" aria-label="Skip envelope opening">
    <span class="skip-text">Skip Intro</span>
    <span class="skip-arrow" aria-hidden="true">→</span>
  </button>

  <div class="envelope-stage">
    <!-- End-to-End Screen 3D Perspective Wrapper -->
    <div id="envelope-interactive-card" class="envelope-card-wrapper" role="button" tabindex="0" aria-label="Click or tap anywhere to open wedding invitation envelope">
      
      <!-- ENVELOPE PACKET (End-to-End Full Screen) -->
      <div class="envelope-packet">
        
        <!-- 1. INSIDE BACK PANEL (Lining) -->
        <div class="envelope-inside-back">
          <div class="envelope-inside-pattern"></div>
          
          <!-- Inner Invitation Card (Smoothly emerges upon opening) -->
          <div class="envelope-inner-card" id="envelope-inner-card">
            <div class="inner-card-border">
              <span class="inner-card-monogram">J&S</span>
              <span class="inner-card-lead">WEDDING INVITATION</span>
            </div>
          </div>
        </div>

        <!-- 2. WARM INNER LIGHT (Physically situated inside the envelope pocket) -->
        <div class="envelope-inner-glow" id="envelope-inner-glow" aria-hidden="true"></div>

        <!-- 3. SIDE FLAPS (Left & Right - End to End) -->
        <svg class="envelope-side-flaps" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="leftFlapGrad" x1="0%" y1="0%" x2="100%" y2="50%">
              <stop offset="0%" stop-color="#FAF4EA" />
              <stop offset="80%" stop-color="#F2E9DC" />
              <stop offset="100%" stop-color="#E8DCB9" />
            </linearGradient>
            <linearGradient id="rightFlapGrad" x1="100%" y1="0%" x2="0%" y2="50%">
              <stop offset="0%" stop-color="#FAF4EA" />
              <stop offset="80%" stop-color="#F2E9DC" />
              <stop offset="100%" stop-color="#E8DCB9" />
            </linearGradient>
          </defs>
          <!-- Left Flap -->
          <polygon points="0,0 520,500 0,1000" fill="url(#leftFlapGrad)" />
          <line x1="0" y1="0" x2="520" y2="500" stroke="rgba(199, 167, 123, 0.45)" stroke-width="1.5" />
          <line x1="520" y1="500" x2="0" y2="1000" stroke="rgba(199, 167, 123, 0.35)" stroke-width="1.5" />

          <!-- Right Flap -->
          <polygon points="1000,0 480,500 1000,1000" fill="url(#rightFlapGrad)" />
          <line x1="1000" y1="0" x2="480" y2="500" stroke="rgba(199, 167, 123, 0.45)" stroke-width="1.5" />
          <line x1="480" y1="500" x2="1000" y2="1000" stroke="rgba(199, 167, 123, 0.35)" stroke-width="1.5" />
        </svg>

        <!-- 4. BOTTOM FLAP (End to End) -->
        <svg class="envelope-bottom-flap" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="bottomFlapGrad" x1="50%" y1="100%" x2="50%" y2="0%">
              <stop offset="0%" stop-color="#FAF4EA" />
              <stop offset="65%" stop-color="#F3EADC" />
              <stop offset="100%" stop-color="#E9DDCF" />
            </linearGradient>
            <filter id="bottomFlapShadow" x="-10%" y="-10%" width="120%" height="120%">
              <feDropShadow dx="0" dy="-4" stdDeviation="8" flood-color="rgba(81, 70, 63, 0.12)" />
            </filter>
          </defs>
          <polygon points="0,1000 500,440 1000,1000" fill="url(#bottomFlapGrad)" filter="url(#bottomFlapShadow)" />
          <line x1="0" y1="1000" x2="500" y2="440" stroke="rgba(199, 167, 123, 0.55)" stroke-width="1.5" />
          <line x1="500" y1="440" x2="1000" y2="1000" stroke="rgba(199, 167, 123, 0.55)" stroke-width="1.5" />
        </svg>

        <!-- 5. TOP FOLDING FLAP (End to End 3D Animated) -->
        <div class="envelope-top-flap-hinge" id="envelope-top-flap-hinge">
          <div class="envelope-top-flap-3d">
            
            <!-- FRONT FACE OF TOP FLAP (Closed State) -->
            <div class="flap-face flap-face-front">
              <svg class="top-flap-svg" viewBox="0 0 1000 560" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="topFlapFrontGrad" x1="50%" y1="0%" x2="50%" y2="100%">
                    <stop offset="0%" stop-color="#FFFDF8" />
                    <stop offset="55%" stop-color="#FBF4E8" />
                    <stop offset="100%" stop-color="#EDE2D1" />
                  </linearGradient>
                  <filter id="topFlapShadow" x="-10%" y="0%" width="120%" height="140%">
                    <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="rgba(81, 70, 63, 0.2)" />
                  </filter>
                </defs>
                <polygon points="0,0 500,556 1000,0" fill="url(#topFlapFrontGrad)" filter="url(#topFlapShadow)" />
                <line x1="0" y1="0" x2="500" y2="556" stroke="rgba(212, 175, 55, 0.7)" stroke-width="2" />
                <line x1="500" y1="556" x2="1000" y2="0" stroke="rgba(212, 175, 55, 0.7)" stroke-width="2" />
              </svg>

              <!-- ROYAL J&S EMBOSSED CREST SEAL ON FLAP TIP -->
              <div class="envelope-wax-seal">
                <div class="wax-seal-outer-rim">
                  <div class="wax-seal-inner-circle">
                    <img 
                      src="/jony-wedding/assets/decorations/wedding-logo-crest.png" 
                      alt="J&S Royal Monogram Wax Seal" 
                      class="seal-crest-img"
                      width="68" 
                      height="68" 
                      loading="eager"
                      decoding="sync"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- BACK FACE OF TOP FLAP (Revealed upon 3D flip) -->
            <div class="flap-face flap-face-back" aria-hidden="true">
              <svg class="top-flap-svg-back" viewBox="0 0 1000 560" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="topFlapBackGrad" x1="50%" y1="100%" x2="50%" y2="0%">
                    <stop offset="0%" stop-color="#EDE2D1" />
                    <stop offset="60%" stop-color="#F7EFE2" />
                    <stop offset="100%" stop-color="#FFFDF8" />
                  </linearGradient>
                </defs>
                <polygon points="0,560 500,4 1000,560" fill="url(#topFlapBackGrad)" />
                <line x1="0" y1="560" x2="500" y2="4" stroke="rgba(199, 167, 123, 0.45)" stroke-width="1.5" />
                <line x1="500" y1="4" x2="1000" y2="560" stroke="rgba(199, 167, 123, 0.45)" stroke-width="1.5" />
              </svg>
              <div class="top-flap-back-ornament">❦</div>
            </div>

          </div>
        </div>

      </div>

      <!-- 6. AMBIENT EXPANDING LIGHT BLOOM (Illuminates screen to transition smoothly into invitation) -->
      <div class="envelope-light-bloom" id="envelope-light-bloom" aria-hidden="true"></div>

      <!-- INVITATION INTERACTIVE PROMPT (At bottom of screen) -->
      <div class="envelope-prompt-container">
        <div class="envelope-tap-pill">
          <span class="envelope-sparkle">✦</span>
          <span class="envelope-prompt-text">TAP TO OPEN</span>
          <span class="envelope-sparkle">✦</span>
        </div>
        <p class="envelope-caption">A Wedding Invitation for Jony & Sunny</p>
      </div>

    </div>
  </div>
</div>

<script>
  function initEnvelopeExperience() {
    const overlay = document.getElementById("envelope-experience-overlay");
    const envelopeCard = document.getElementById("envelope-interactive-card");
    const skipBtn = document.getElementById("envelope-skip-btn");

    if (!overlay || !envelopeCard) return;

    let isOpening = false;
    let hasDismissed = false;

    // Lock page scrolling while envelope overlay is active
    document.body.style.overflow = "hidden";

    function openEnvelope() {
      if (isOpening || hasDismissed) return;
      isOpening = true;

      // Check prefers-reduced-motion
      const prefersReduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReduced) {
        dismissImmediately();
        return;
      }

      // Step 1: Trigger gradual 3D top flap flip, warm inner light emergence, and expansion
      overlay.classList.add("envelope-is-opening");

      // Step 2: Fade out overlay smoothly after realistic ~4.5s cinematic unfold
      // The expanding light reaches soft peak at ~3.6s, then gently transitions into the invitation
      setTimeout(() => {
        overlay.classList.add("envelope-fade-out");
        document.body.style.overflow = "";
      }, 3600);

      // Step 3: Remove from DOM view after full ~4.9s transition
      setTimeout(() => {
        hasDismissed = true;
        overlay.style.display = "none";
        window.dispatchEvent(new CustomEvent("wedding-envelope-opened"));
      }, 4900);
    }

    function dismissImmediately() {
      if (hasDismissed) return;
      hasDismissed = true;
      document.body.style.overflow = "";
      overlay.classList.add("envelope-fade-out");
      setTimeout(() => {
        overlay.style.display = "none";
        window.dispatchEvent(new CustomEvent("wedding-envelope-opened"));
      }, 400);
    }

    // Skip button click handler
    if (skipBtn) {
      skipBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        e.preventDefault();
        dismissImmediately();
      });
    }

    // Click/tap handler on overlay or envelope
    overlay.addEventListener("click", (e) => {
      if (skipBtn && skipBtn.contains(e.target as Node)) return;
      e.preventDefault();
      openEnvelope();
    });

    overlay.addEventListener("touchend", (e) => {
      if (skipBtn && skipBtn.contains(e.target as Node)) return;
      e.preventDefault();
      openEnvelope();
    }, { passive: false });

    // Keyboard accessibility (Escape for skip, Enter or Space to open)
    window.addEventListener("keydown", (e) => {
      if (hasDismissed) return;
      if (e.key === "Escape") {
        e.preventDefault();
        dismissImmediately();
      } else if (!isOpening && (e.key === "Enter" || e.key === " ")) {
        e.preventDefault();
        openEnvelope();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initEnvelopeExperience);
  } else {
    initEnvelopeExperience();
  }
</script>
