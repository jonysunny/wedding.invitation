---
interface WeddingEvent {
  id: string;
  name?: string;
  title?: string;
  date: string;
  time: string;
  venue: string;
  address: string;
  mapsUrl?: string | null;
  description?: string;
  badge?: string;
  isConfirmed?: boolean;
}

interface Props {
  events: WeddingEvent[];
}

const { events } = Astro.props;
const ceremonyEvent = events.find((e) => e.id === "wedding-ceremony") || events[0];
const receptionEvent = events.find((e) => e.id === "reception-dinner") || events[1];
---

<div id="event-schedule" class="events-schedule-wrapper">
  <!-- SECTION 5: DEDICATED WEDDING CEREMONY INVITATION PAGE -->
  {ceremonyEvent && (
    <section id="ceremony-section" class="invite-section ceremony-invitation-page reveal-on-scroll">
      <!-- Unique Floral Corner Layer: Ceremony Composition (Left-Garland Floral Arrangement) -->
      <div class="lavender-section-decor decor-comp-ceremony" aria-hidden="true">
        <div class="lavender-corner-item lavender-corner-tl"></div>
        <div class="lavender-corner-item lavender-corner-tr"></div>
        <div class="lavender-corner-item lavender-corner-bl"></div>
        <div class="lavender-corner-item lavender-corner-br"></div>
      </div>

      <!-- Perimeter Luxury Double Border Inset -->
      <div class="invitation-page-border" aria-hidden="true">
        <div class="invitation-page-inner-border"></div>
      </div>
      <div class="invitation-corner-ornaments" aria-hidden="true">
        <span class="corner-ornament corner-top-left">❦</span>
        <span class="corner-ornament corner-top-right">❦</span>
        <span class="corner-ornament corner-bottom-left">❦</span>
        <span class="corner-ornament corner-bottom-right">❦</span>
      </div>

      <div class="page-invitation-card ceremony-card stationery-panel">
        <div class="event-card-inner">
          <div class="event-card-header">
            {ceremonyEvent.badge && (
              <span class="event-badge badge-ceremony">{ceremonyEvent.badge}</span>
            )}
            <h2 class="section-title event-title">{ceremonyEvent.title || ceremonyEvent.name}</h2>
            <div class="botanical-divider event-mini-divider">
              <span class="botanical-divider-icon">❦</span>
            </div>
            {ceremonyEvent.description && (
              <p class="event-description">{ceremonyEvent.description}</p>
            )}
          </div>

          <div class="event-details-list">
            <div class="event-detail-row">
              <span class="detail-icon" aria-hidden="true">📅</span>
              <div class="detail-text">
                <span class="detail-label">Date</span>
                <strong class="detail-value">{ceremonyEvent.date}</strong>
              </div>
            </div>

            <div class="event-detail-row">
              <span class="detail-icon" aria-hidden="true">⏰</span>
              <div class="detail-text">
                <span class="detail-label">Time</span>
                <strong class="detail-value time-highlight">{ceremonyEvent.time}</strong>
              </div>
            </div>

            <div class="event-detail-row">
              <span class="detail-icon" aria-hidden="true">⛪</span>
              <div class="detail-text">
                <span class="detail-label">Venue</span>
                <strong class="detail-value venue-title">{ceremonyEvent.venue}</strong>
                <span class="detail-sub">{ceremonyEvent.address}</span>
              </div>
            </div>
          </div>

          {ceremonyEvent.mapsUrl && (
            <div class="event-action-wrap">
              <a 
                href={ceremonyEvent.mapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-champagne event-directions-btn"
                aria-label={`Get directions to ${ceremonyEvent.venue}`}
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                View Church & Directions
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- SECTION 6: DEDICATED RECEPTION & DINNER INVITATION PAGE -->
  {receptionEvent && (
    <section id="reception-section" class="invite-section reception-invitation-page reveal-on-scroll">
      <!-- Unique Floral Corner Layer: Reception Composition (Right-Garland Floral Arrangement) -->
      <div class="lavender-section-decor decor-comp-reception" aria-hidden="true">
        <div class="lavender-corner-item lavender-corner-tl"></div>
        <div class="lavender-corner-item lavender-corner-tr"></div>
        <div class="lavender-corner-item lavender-corner-bl"></div>
        <div class="lavender-corner-item lavender-corner-br"></div>
      </div>

      <!-- Perimeter Luxury Double Border Inset -->
      <div class="invitation-page-border" aria-hidden="true">
        <div class="invitation-page-inner-border"></div>
      </div>
      <div class="invitation-corner-ornaments" aria-hidden="true">
        <span class="corner-ornament corner-top-left">❦</span>
        <span class="corner-ornament corner-top-right">❦</span>
        <span class="corner-ornament corner-bottom-left">❦</span>
        <span class="corner-ornament corner-bottom-right">❦</span>
      </div>

      <div class="page-invitation-card reception-card stationery-panel">
        <div class="event-card-inner">
          <div class="event-card-header">
            {receptionEvent.badge && (
              <span class="event-badge badge-reception">{receptionEvent.badge}</span>
            )}
            <h2 class="section-title event-title">{receptionEvent.title || receptionEvent.name}</h2>
            <div class="botanical-divider event-mini-divider">
              <span class="botanical-divider-icon">❦</span>
            </div>
            {receptionEvent.description && (
              <p class="event-description">{receptionEvent.description}</p>
            )}
          </div>

          <div class="event-details-list">
            <div class="event-detail-row">
              <span class="detail-icon" aria-hidden="true">📅</span>
              <div class="detail-text">
                <span class="detail-label">Date</span>
                <strong class="detail-value">{receptionEvent.date}</strong>
              </div>
            </div>

            <div class="event-detail-row">
              <span class="detail-icon" aria-hidden="true">🍷</span>
              <div class="detail-text">
                <span class="detail-label">Time</span>
                <strong class="detail-value time-highlight">{receptionEvent.time}</strong>
              </div>
            </div>

            <div class="event-detail-row">
              <span class="detail-icon" aria-hidden="true">🍽️</span>
              <div class="detail-text">
                <span class="detail-label">Venue</span>
                <strong class="detail-value venue-title">{receptionEvent.venue}</strong>
                <span class="detail-sub">{receptionEvent.address}</span>
              </div>
            </div>
          </div>

          {!receptionEvent.isConfirmed && (
            <div class="reception-status-banner">
              <span class="status-sparkle">✦</span>
              <span>Venue, address & timing will be announced as soon as confirmed</span>
            </div>
          )}

          {receptionEvent.mapsUrl && (
            <div class="event-action-wrap">
              <a 
                href={receptionEvent.mapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-champagne event-directions-btn"
                aria-label={`Get directions to ${receptionEvent.venue}`}
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                View Reception Venue
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}
</div>